<Project>
  <PropertyGroup>
    <FluffySimVersion>3.1.0</FluffySimVersion>
    <Version>$(FluffySimVersion)</Version>
    <AssemblyVersion>$(FluffySimVersion).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(FluffySimVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
